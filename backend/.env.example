# ─────────────────────────────────────────────────────────────
#  ARIA Environment Variables
#  Copy this file to .env and fill in your actual keys
# ─────────────────────────────────────────────────────────────

# Get your FREE Groq API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Get your FREE NewsAPI key at: https://newsapi.org  (used in Phase 2)
NEWS_API_KEY=your_newsapi_key_here

# Optional: Groq model override (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b
# Optional: reasoning effort for gpt-oss models — low | medium | high (default: low)
# GROQ_REASONING_EFFORT=low
